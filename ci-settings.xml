<?xml version="1.0" encoding="UTF-8"?>
<!-- Maven settings for builds that are not on a developer laptop: the Docker
     build stage (token from the gh_token BuildKit secret) and CI. Holds no
     secret itself: the password is read from the environment at build time. -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
    <servers>
        <server>
            <id>github</id>
            <username>PrathameshMax</username>
            <password>${env.GITHUB_PACKAGES_TOKEN}</password>
        </server>
    </servers>
</settings>
